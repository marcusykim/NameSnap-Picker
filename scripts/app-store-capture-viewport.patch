+// Capture fixtures change only the viewport; Release keeps the original content.
+private struct ScreenshotViewport<Content: View>: View {
+    @ViewBuilder let content: () -> Content
+
+    var body: some View {
+        #if DEBUG
+        ScrollViewReader { proxy in
+            content().onAppear {
+                let arguments = ProcessInfo.processInfo.arguments
+                guard let index = arguments.firstIndex(of: "-ui-screenshot-scroll"),
+                      arguments.indices.contains(index + 1) else { return }
+                let target = arguments[index + 1]
+                guard ["draw", "history"].contains(target) else { return }
+                DispatchQueue.main.asyncAfter(deadline: .now() + 0.8) {
+                    proxy.scrollTo("capture-\(target)", anchor: .top)
+                }
+            }
+        }
+        #else
+        content()
+        #endif
+    }
+}
