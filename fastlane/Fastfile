default_platform(:ios)

APP_IDENTIFIER = "com.marcuskim.namesnap"
APP_VERSION = "2.0"
APP_BUILD = "18"
API_KEY_ID = "4HA95XB6S5"
API_KEY_ISSUER_ID = "67c52852-b22f-4e49-ad81-df53bf4476fb"
API_KEY_PATH = "/Users/marcuskim/.AuthKey_4HA95XB6S5.p8"

def namesnap_api_key
  app_store_connect_api_key(
    key_id: API_KEY_ID,
    issuer_id: API_KEY_ISSUER_ID,
    key_filepath: API_KEY_PATH
  )
end

platform :ios do
  desc "Upload the signed NameSnap build to App Store Connect"
  lane :upload_build do
    ipa_path = ENV.fetch("NAMESNAP_IPA_PATH")

    upload_to_app_store(
      api_key: namesnap_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      ipa: ipa_path,
      skip_app_version_update: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Upload production listing metadata and final screenshots"
  lane :upload_listing do
    upload_to_app_store(
      api_key: namesnap_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      metadata_path: File.expand_path("metadata", __dir__),
      screenshots_path: File.expand_path("../AppStoreAssets/ReleaseScreenshots", __dir__),
      skip_screenshots: false,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      automatic_release: true,
      force: true,
      copyright: "2026 Marcus Kim",
      primary_category: "UTILITIES",
      secondary_category: "ENTERTAINMENT",
      app_review_information: {
        first_name: "Marcus",
        last_name: "Kim",
        email_address: "sidequestsoftware@proton.me",
        demo_user: "",
        demo_password: "",
        notes: "NameSnap is a random name picker for classrooms, giveaways, games, and live streams. No account is required. The free tier allows up to 16 contestants per session. Unlimited Monthly provides ongoing access to unlimited recurring classroom, livestream, giveaway, and event sessions. Unlimited Lifetime provides that access as a one-time purchase. Restore Purchases is on the same Unlimited screen. The paywall clearly shows the monthly duration, localized StoreKit price, renewal disclosure, Privacy Policy link, and Apple Standard EULA link. The App Store description also includes the Standard EULA URL. Participant names and winner history stay on device."
      }
    )
  end

  desc "Select build 18 and submit NameSnap 2.0 for full App Store review"
  lane :submit_production do
    upload_to_app_store(
      api_key: namesnap_api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: APP_VERSION,
      build_number: APP_BUILD,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      reject_if_possible: true,
      run_precheck_before_submit: false,
      automatic_release: true,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true
      }
    )
  end
end
