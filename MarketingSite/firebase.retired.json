{
  "hosting": {
    "site": "namesnap-picker-6759588637",
    "public": "retired-host",
    "ignore": [
      "firebase.retired.json",
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://getnamesnap.web.app/",
        "type": 301
      },
      {
        "regex": "^/(?P<path>[^_].*|_[^_].*|_)$",
        "destination": "https://getnamesnap.web.app/:path",
        "type": 301
      }
    ]
  }
}
